# Copy to .env for local Postgres. Values below are placeholders, not credentials.
# On Vercel, set the real values in the project environment. Do not commit .env.

# Pooled runtime URL. Supavisor transaction mode, port 6543.
# The app reads this first. If it is unset, POSTGRES_PRISMA_URL is used.
DATABASE_URL="postgresql://opencal_app:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct or session URL for migrations and the SQLite copy. Port 5432.
# The app reads this first. If it is unset, POSTGRES_URL_NON_POOLING is used.
# Do not put the transaction pooler here.
DIRECT_URL="postgresql://opencal_app:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional Marketplace names. Ignored when DATABASE_URL and DIRECT_URL are set.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth.js. AUTH_SECRET is required in production.
# Set AUTH_URL only on the Vercel Production environment, to the canonical https origin.
# Leave AUTH_URL unset on Preview so trustHost keeps each preview host.
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=

# OAuth. Redirect URIs are documented in docs/VERCEL.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Bearer secret for GET and POST /api/cron/sync. Required for Vercel Cron.
CRON_SECRET=

# Must be unset or false on Vercel. true enables the mock provider and the demo MCP bearer.
DEMO_MODE=

# Used only by the local stdio probe (src/mcp/standalone.ts), not by the Vercel app.
OPENCAL_URL=
OPENCAL_MCP_TOKEN=
